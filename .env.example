# ==============================================================================
# SPACE STREAM OVERLAY - AUTO-DETECTOR CONFIGURATION EXAMPLE
# Copy this file to '.env' and fill in your custom credentials.
# ==============================================================================

# Server connection configuration
PORT=8787
HOST=127.0.0.1
OVERLAY_API_URL=http://127.0.0.1:8787/api/action

# Hosted Vercel persistence (optional but required for the hosted /control page
# to survive serverless restarts). Add Upstash Redis through Vercel Marketplace,
# then Vercel will inject these into the project automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
OVERLAY_STATE_KEY=space-stream-overlay:state:v1

# Streamlabs Socket Token
# To find your token:
# 1. Log in to your Streamlabs Dashboard (https://streamlabs.com/dashboard)
# 2. Go to Settings -> API Settings -> API Tokens
# 3. Copy the "Your Socket API Token" value and paste it below.
STREAMLABS_SOCKET_TOKEN=your_streamlabs_socket_token_here

# Fortnite / Universal OCR Coordinates (Defaults for 1080p screens)
# Bounding Box format: X, Y, Width, Height
# (Use the CLI calibrator to fine-tune these to your resolution/HUD Scale)

# Fortnite Top-Right Kill Counter Area (Default: X=1720, Y=70, W=140, H=60)
FORTNITE_KILLS_ROI_X=1720
FORTNITE_KILLS_ROI_Y=70
FORTNITE_KILLS_ROI_W=140
FORTNITE_KILLS_ROI_H=60

# Fortnite Victory Royale Pop-up Center Area (Default: X=400, Y=200, W=1120, H=250)
FORTNITE_WINS_ROI_X=400
FORTNITE_WINS_ROI_Y=200
FORTNITE_WINS_ROI_W=1120
FORTNITE_WINS_ROI_H=250

# Universal OCR Coordinates
UNIVERSAL_OCR_ROI_X=1720
UNIVERSAL_OCR_ROI_Y=70
UNIVERSAL_OCR_ROI_W=140
UNIVERSAL_OCR_ROI_H=60
